                          "kalshiOrderId": {
                            "type": "string"
                          },
                          "userId": {
                            "type": "string"
                          },
                          "marketId": {
                            "type": "string"
                          },
                          "side": {
                            "type": "string",
                            "enum": [
                              "yes",
                              "no"
                            ]
                          },
                          "action": {
                            "type": "string",
