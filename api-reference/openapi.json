                        "required": [
                          "kalshiOrderId",
                          "userId",
                          "marketId",
                          "side",
                          "action",
                          "requestedQuantity",
                          "filledQuantity",
                          "filledUusdc",
                          "priceUusdc",
                          "chain",
                          "createdAt",
                          "updatedAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "orders"
